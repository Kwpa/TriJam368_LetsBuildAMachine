theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "You have limited actions each turn. Change the number of actions per turn with the difficulty setting: 

[center][img=40%]res://textures/difficulty_image.png[/img][/center]

Spend your actions by
[ul]
Clicking on the deck to draw a card into your hand
Clicking on a card, then on the grid to add a part to your machine
[/ul]




[center]4/6[/center]"
