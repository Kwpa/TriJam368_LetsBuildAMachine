theme = ExtResource("1_3spy8")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Once the plant is two tiles large, it will need more resources. Be sure to get light on both of its tiles! 

To fulfill water and nutrient needs for a larger plant, sprinkle them on both tiles, or sprinkle on either tile and make a direct connection to the plant's pot.

One sprinkler can dispnse both water and nutrients, but a nutrients can't pass through a resevoir and water won't flow through a compost bin. This sprinkler only dispenses water, not nutrients:
[center][img=20%]res://textures/generators_block_image.png[/img][/center]
[center]3/6[/center]"
vertical_alignment = 1

