[node name="Text2" type="RichTextLabel" parent="Page2/VBoxContainer" unique_id=2143285530]
custom_minimum_size = Vector2(600, 425)
layout_mode = 2
theme = ExtResource("1_3spy8")
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Special tiles dispense resources:
[img=8%]res://textures/icon_lamp.png[/img] The lamp provides light.
[img=8%]res://textures/icon_reservoir.png[/img] The reservoir generates water. 
[img=8%]res://textures/icon_compost.png[/img] The compost bin generates nutrients. 

[img=8%]res://textures/icon_generator.png[/img] The electricity generator provides [img=5%]res://textures/icon_electricity.png[/img]electricity to tiles it's connected to. The lamp, the reservoir and the compost bin all need electricity to produce their resource.

Water and nutrients can be connected directly to the plant's pot, or sprinkled from a sprinkler. [img=8%]res://textures/icon_sprinkler.png[/img]
[center]2/6[/center]"
vertical_alignment = 1

